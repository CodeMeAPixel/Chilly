BOT_TOKEN=your_discord_bot_token_here
BOT_STATUS=online
BOT_ACTIVITY_NAME=Music • /play
BOT_ACTIVITY_TYPE=listening

# Public website, linked from bot messages and buttons
SITE_URL=https://chillybot.space

# Lyrics provider (LRCLIB-compatible API)
LYRICS_API_URL=https://lrclib.net

NODE_NAME=node-1
NODE_ADDRESS=lavalink:2333
NODE_PASSWORD=youshallnotpass
NODE_SECURE=false

# Optional additional nodes (NODE_1_* .. NODE_10_*). New players go to the least
# loaded connected node, and players move to a healthy node if theirs goes down.
# NODE_2_NAME=node-2
# NODE_2_ADDRESS=lavalink-2:2333
# NODE_2_PASSWORD=youshallnotpass
# NODE_2_SECURE=false

# Lavalink search prefixes tried in order for plain-text queries.
# Aliases: youtube, youtubemusic, soundcloud, spotify, deezer, applemusic
SEARCH_PROVIDERS=scsearch,spsearch,dzsearch

# Dashboard / website API
# The Next.js site proxies /api/v1 to this server, so every URL below is the website's URL.
# Local dev: set all three to http://localhost:3000 and API_COOKIE_SECURE=false.
API_ENABLED=false
API_ADDRESS=:8080
# The Discord redirect URI is API_PUBLIC_URL/api/v1/auth/callback
API_PUBLIC_URL=https://chilly.example.com
API_DASHBOARD_URL=https://chilly.example.com
API_ALLOWED_ORIGINS=https://chilly.example.com
# Only needed when the browser talks to the API on a different subdomain (e.g. .example.com)
API_COOKIE_DOMAIN=
API_COOKIE_SECURE=true
API_SESSION_TTL=168h
# Trust X-Forwarded-For (Dokploy/Traefik)
API_TRUST_PROXY=true
# Discord user ids with access to every guild in the API
API_ADMIN_USER_IDS=
# OAuth2 credentials from the Discord developer portal (client id defaults to the bot's application id)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# AzuraCast radio (Lavalink needs `lavalink.server.sources.http: true`)
AZURACAST_ENABLED=false
AZURACAST_URL=https://radio.example.com
AZURACAST_API_KEY=
# Optional comma separated allow-list of station shortcodes
AZURACAST_STATIONS=
AZURACAST_POLL_INTERVAL=15s
# Optional: rewrite stream URLs for Lavalink to an internal address, e.g. http://azuracast:80
AZURACAST_STREAM_BASE_URL=

MUSIC_TRACKER_ENABLED=false
MUSIC_TRACKER_CHANNEL_ID=
MUSIC_TRACKER_GUILD_ID=
MUSIC_TRACKER_HOST_ADDRESS=
MUSIC_TRACKER_HTTP_PATH=
MUSIC_TRACKER_WEBSOCKET_PATH=
MUSIC_TRACKER_ALLOWED_ORIGINS=

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=chillcordgo
DB_PASSWORD=youshallnotpass
DB_NAME=chillcord_playlist_db

LOG_LEVEL=DEBUG
LOG_FORMAT=text
# Docker/Dokploy: keep dev to write logs to stdout, which Dokploy captures.
# Set LOG_ENV=prod and mount /app/logs if file logs are also needed.
LOG_FILE_PATH=./logs/bot.log
LOG_ADD_SOURCE=true
LOG_ENV=dev
